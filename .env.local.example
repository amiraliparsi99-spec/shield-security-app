# =============================================================================
# Shield — environment variables
# Copy to .env.local and fill in. NEXT_PUBLIC_* are exposed to the browser;
# everything else is server-only. Keep real secrets out of git.
# =============================================================================

# --- Core: Supabase (required) — https://supabase.com -----------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---------------------------------------------------------------------
# Public base URL of the deployment (used to build absolute links).
# NEXT_PUBLIC_APP_URL=https://app.yourdomain.com

# --- Secrets / access control ------------------------------------------------
# Bearer token Vercel cron requests must present. REQUIRED for cron routes —
# they fail closed (reject all) if this is unset. Set in Vercel project env.
# CRON_SECRET=generate-a-long-random-string
# Bearer token for server-to-server access to admin/debug routes.
# ADMIN_API_SECRET=generate-a-long-random-string
# Shared secret for internal service-to-service API calls.
# INTERNAL_API_SECRET=generate-a-long-random-string
# Optional: pre-launch password gate (entire marketing site). Leave unset to
# disable. Set in Vercel when the domain is live but you are not public yet.
# SITE_PASSWORD=your-shared-password
# Allow the shield_guest_role cookie to preview dashboards in production (demo
# mode). Off by default in production; data access is still governed by RLS.
# ALLOW_GUEST_DASHBOARDS=true

# --- Stripe (payments) — https://stripe.com ----------------------------------
# STRIPE_SECRET_KEY=sk_live_or_test
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test
# Signing secret for the Stripe webhook endpoint.
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- Email (Resend) — https://resend.com -------------------------------------
# RESEND_API_KEY=re_...
# From address used for transactional email.
# FROM_EMAIL=Shield <no-reply@yourdomain.com>

# --- Mapbox — https://mapbox.com (free tier: 50,000 map loads/month) ---------
# Public token powers the GPS tracking live map + venue address search.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token
# Server-side token for geocoding API calls (can be the same secret token).
# MAPBOX_ACCESS_TOKEN=pk.your-mapbox-token

# --- Agora (voice calling) — https://console.agora.io ------------------------
# Required for the voice calling feature (free tier: 10,000 minutes/month).
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# --- Rate limiting (Upstash Redis) — https://upstash.com ---------------------
# Optional: when unset, rate limiting falls back to in-memory (per-instance).
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# --- AI assistant (optional) -------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# --- SIA licence verification (optional) -------------------------------------
# SIA_CHECKER_API_KEY=your-sia-checker-key

# --- Monitoring / alerting (optional) ----------------------------------------
# Webhook (e.g. Slack) that receives critical error alerts.
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# =============================================================================
# Tuning knobs (all optional — sensible defaults applied if unset)
# =============================================================================

# --- Shift check-in / check-out ----------------------------------------------
# Max distance (metres) a guard can be from the venue and still check IN.
# CHECK_IN_MAX_DISTANCE_METERS=500
# Max distance (metres) a guard can be from the venue to ACCEPT an urgent shift.
# SHIFT_ACCEPT_MAX_DISTANCE_METERS=500
# Earliest a guard can check in before the shift's scheduled start (minutes).
# CHECK_IN_EARLIEST_MINUTES_BEFORE_START=15
# Minutes past scheduled end a manual checkout can still bill for (capped after).
# CHECKOUT_OVERTIME_GRACE_MINUTES=30
# Minutes past scheduled end the auto-checkout cron waits before firing.
# AUTO_CHECKOUT_GRACE_MINUTES=0

# --- Pre-shift travel risk engine (rings R3/R4/R5/R6) ------------------------
# Distance thresholds in metres. Defaults: 5 km / 2 km / 500 m.
# TRAVEL_RISK_R3_DISTANCE_M=5000
# TRAVEL_RISK_R4_DISTANCE_M=2000
# TRAVEL_RISK_R5_DISTANCE_M=500
# Timing thresholds in minutes (relative to scheduled_start).
# TRAVEL_RISK_R3_MINUTES_BEFORE=30
# TRAVEL_RISK_R4_MINUTES_BEFORE=15
# TRAVEL_RISK_R5_MINUTES_BEFORE=5
# TRAVEL_RISK_R6_MINUTES_AFTER=10
# Discard GPS fixes whose accuracy radius exceeds this many metres.
# TRAVEL_RISK_GPS_ACCURACY_FLOOR_M=250
# Multiplier applied to R3/R4/R5 distances when a venue has is_rural=true.
# TRAVEL_RISK_RURAL_MULTIPLIER=2.5

# --- Cover sourcing waves (auto-cover engine) --------------------------------
# Wave 1 fires immediately on NEEDS_COVER. After delayMinutes the wave-broadening
# cron auto-bumps to wave 2, then wave 3. Default progression: 5mi -> 15mi -> 25mi.
# COVER_WAVE_1_RADIUS_MILES=5
# COVER_WAVE_1_DELAY_MINUTES=5
# COVER_WAVE_2_RADIUS_MILES=15
# COVER_WAVE_2_DELAY_MINUTES=10
# COVER_WAVE_3_RADIUS_MILES=25
