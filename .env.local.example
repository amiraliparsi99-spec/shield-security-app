# Optional: pre-launch password gate (entire marketing site). Leave unset to disable.
# Set in Vercel when the domain is live but you are not public yet.
# SITE_PASSWORD=your-shared-password

# Supabase — https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: add when you enable Stripe
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mapbox — https://mapbox.com (free tier: 50,000 map loads/month)
# Same token powers: GPS tracking live map + venue booking address search (geocoding API)
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token

# Agora — https://console.agora.io (free tier: 10,000 minutes/month)
# Required for voice calling feature
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate

# Shift check-in / check-out tuning (all optional, sensible defaults applied)
# Maximum distance (metres) a guard can be from the venue and still check IN.
# CHECK_IN_MAX_DISTANCE_METERS=500
# Earliest a guard can check in before the shift's scheduled start (minutes).
# CHECK_IN_EARLIEST_MINUTES_BEFORE_START=15
# How many minutes past the scheduled end a manual checkout can still bill
# for. Anything past this cap is silently capped at scheduled_end + grace.
# Prevents runaway pay if a guard's phone is left running long after the shift.
# CHECKOUT_OVERTIME_GRACE_MINUTES=30
# How many minutes past scheduled end the auto-checkout cron waits before it
# fires. Increase if you want guards to have time to manually check out first.
# AUTO_CHECKOUT_GRACE_MINUTES=0

# Pre-shift travel risk engine (rings R3/R4/R5/R6)
# Distance thresholds in metres. Defaults: 5 km / 2 km / 500 m.
# TRAVEL_RISK_R3_DISTANCE_M=5000
# TRAVEL_RISK_R4_DISTANCE_M=2000
# TRAVEL_RISK_R5_DISTANCE_M=500
# Timing thresholds in minutes (relative to scheduled_start).
# TRAVEL_RISK_R3_MINUTES_BEFORE=30
# TRAVEL_RISK_R4_MINUTES_BEFORE=15
# TRAVEL_RISK_R5_MINUTES_BEFORE=5
# TRAVEL_RISK_R6_MINUTES_AFTER=10
# Discard GPS fixes whose accuracy radius exceeds this many metres for distance
# checks (a 2 km accuracy fix tells us nothing about whether the guard is at the site).
# TRAVEL_RISK_GPS_ACCURACY_FLOOR_M=250
# Multiplier applied to R3/R4/R5 distances when a venue has is_rural=true.
# TRAVEL_RISK_RURAL_MULTIPLIER=2.5

# Cover sourcing waves (auto-cover engine)
# Wave 1 fires immediately on NEEDS_COVER. After delayMinutes the wave-broadening
# cron auto-bumps to wave 2, then wave 3. Default progression: 5mi -> 15mi -> 25mi.
# COVER_WAVE_1_RADIUS_MILES=5
# COVER_WAVE_1_DELAY_MINUTES=5
# COVER_WAVE_2_RADIUS_MILES=15
# COVER_WAVE_2_DELAY_MINUTES=10
# COVER_WAVE_3_RADIUS_MILES=25
