{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Debug"
      },
      "env": {
        "EXPO_PUBLIC_AGORA_APP_ID": "748c1468bb06409ab124616208a00d80",
        "EXPO_PUBLIC_API_URL": "http://localhost:3000"
      }
    },
    "development-device": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_AGORA_APP_ID": "748c1468bb06409ab124616208a00d80",
        "EXPO_PUBLIC_API_URL": "https://your-production-url.vercel.app"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_AGORA_APP_ID": "748c1468bb06409ab124616208a00d80",
        "EXPO_PUBLIC_API_URL": "https://your-production-url.vercel.app"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_AGORA_APP_ID": "748c1468bb06409ab124616208a00d80",
        "EXPO_PUBLIC_API_URL": "https://your-production-url.vercel.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
