# Supabase — same as web app; create .env and add your values
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API URL for backend calls (token generation, etc.)
EXPO_PUBLIC_API_URL=http://localhost:3000

# Stripe publishable key (same as NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY in web app)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Agora — https://console.agora.io (free tier: 10,000 minutes/month)
# Required for voice calling feature
EXPO_PUBLIC_AGORA_APP_ID=your-agora-app-id

# Google Sign-In — required for "Continue with Google" on iOS.
#   1. Google Cloud Console → APIs & Services → Credentials
#   2. Create OAuth 2.0 Client ID — Application type "iOS"
#      Bundle ID: app.shield.mobile  → copy the Client ID below.
#   3. Create another OAuth 2.0 Client ID — Application type "Web"
#      → use the Web Client ID below; also paste it (with secret) into
#        Supabase → Authentication → Providers → Google.
#   4. The "iosUrlScheme" in mobile/app.json must be set to the REVERSED
#      iOS client id (e.g. com.googleusercontent.apps.123456-abcdef).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
